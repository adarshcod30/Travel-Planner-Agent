# ==============================================================================
# Travel Planner Agent — environment configuration
#
# Copy to .env and fill in the blanks.  .env is gitignored; never commit secrets.
#   cp .env.example .env
# ==============================================================================


# ------------------------------------------------------------------------------
# AWS / Bedrock
# ------------------------------------------------------------------------------
# Either set the two keys below, OR leave them blank and set AWS_PROFILE to a
# profile configured with `aws configure --profile <name>`. A profile is the
# safer option — the secret never sits in a project file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=travel-planner

AWS_REGION=us-east-1


# ------------------------------------------------------------------------------
# Bedrock models — Amazon Nova, tiered by agent role
# ------------------------------------------------------------------------------
# Values below were resolved against the account and smoke-tested with a live
# Converse call — not guessed. To re-resolve (e.g. on a different account):
#
#   aws bedrock list-foundation-models --region us-east-1 --by-provider Amazon \
#     --query 'modelSummaries[].modelId' --output table
#   aws bedrock list-inference-profiles --region us-east-1 \
#     --query 'inferenceProfileSummaries[].inferenceProfileId' --output table
#
# Prefer the cross-region inference profile (the "us." prefixed id) where one
# exists — better availability and throughput than the bare model id.

# Reasoning-heavy: orchestrator, review, itinerary
BEDROCK_MODEL_TIER_HIGH=us.amazon.nova-pro-v1:0
# Moderate: destination, hotel, attractions, budget
BEDROCK_MODEL_TIER_MID=us.amazon.nova-lite-v1:0
# Extraction-shaped: weather, packing, customs
BEDROCK_MODEL_TIER_LOW=us.amazon.nova-micro-v1:0
# Per-agent fallback when structured output proves unreliable on Nova
BEDROCK_MODEL_FALLBACK=us.meta.llama3-3-70b-instruct-v1:0

# maxTokens MUST be set explicitly on every call. Left unset, Bedrock defaults to
# the model maximum and silently reserves far more quota than the request needs,
# which surfaces later as ThrottlingException on requests that look small.
BEDROCK_MAX_TOKENS_HIGH=4096
BEDROCK_MAX_TOKENS_MID=2048
BEDROCK_MAX_TOKENS_LOW=1024

BEDROCK_TEMPERATURE=0.3
# Adaptive retry mode backs off on throttling instead of hammering.
BEDROCK_MAX_RETRIES=5
BEDROCK_RETRY_MODE=adaptive
BEDROCK_READ_TIMEOUT=60

# Structured-output resilience (see DEVELOPMENT_PLAN.md §3)
STRUCTURED_OUTPUT_MAX_REPAIRS=1
STRUCTURED_OUTPUT_ESCALATE_TIER=true


# ------------------------------------------------------------------------------
# Aegra server
# ------------------------------------------------------------------------------
AEGRA_CONFIG=aegra.json
HOST=0.0.0.0
PORT=2026
SERVER_URL=http://localhost:2026

# noop = no auth (local dev) | custom = use src/travel_planner/auth/handler.py
AUTH_TYPE=noop

# false => LocalExecutor: runs execute in-process as asyncio tasks, no Redis and
# no worker processes needed. Flip to true (and set REDIS_URL) only when
# multi-instance concurrency or crash recovery is actually required.
REDIS_BROKER_ENABLED=false
# REDIS_URL=redis://localhost:6379/0

ENV_MODE=LOCAL
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_STARTUP=true


# ------------------------------------------------------------------------------
# PostgreSQL (native install, no Docker)
# ------------------------------------------------------------------------------
# Aegra owns checkpoints, threads, runs and assistants in this database.
DATABASE_URL=postgresql://travel_planner:CHANGE_ME@localhost:5432/travel_planner
# PGSSLMODE=require        # for managed Postgres (RDS et al.)

SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20


# ------------------------------------------------------------------------------
# MCP servers (v5 only)
# ------------------------------------------------------------------------------
# stdio  = this process spawns the server itself, fresh per run (nothing else to
#          start, nothing persists between runs)
# http   = connect to an already-running server; browser state persists across a
#          whole conversation, at the cost of a second process to manage
MCP_MODE=stdio

PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp
PLAYWRIGHT_MCP_HEADLESS=true

# Sandbox root for the filesystem MCP server. Nothing outside this is reachable.
FILESYSTEM_MCP_ROOT=./data/workspace

TRAVEL_MCP_COMMAND=python
TRAVEL_MCP_ARGS="-m travel_mcp.server"


# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# Hard ceiling on the v3/v4/v5 orchestrator revision loop.
MAX_ORCHESTRATOR_ITERATIONS=3
DEFAULT_VERSION=v5_mcp


# ------------------------------------------------------------------------------
# Frontend (Next.js reads its own frontend/.env.local — this is the value to use)
# ------------------------------------------------------------------------------
# Server-side only. Aegra is never called from the browser; Next.js route
# handlers proxy to it, which removes CORS and keeps credentials off the client.
AEGRA_URL=http://localhost:2026
