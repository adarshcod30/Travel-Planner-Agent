# ---- Local-only prototype reference (never committed) ----
_reference/

# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
dist/
build/
venv/
.venv/
env/
# .python-version IS committed — uv uses it to pin the interpreter
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

