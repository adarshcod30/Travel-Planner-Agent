__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
dist/
build/
venv/
.venv/
env/
# .python-version IS committed — uv uses it to pin the interpreter
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Databases & runtime data ----
*.db
*.sqlite3
logs/
*.log

# ---- Playwright / MCP runtime ----
.playwright-mcp/
playwright-report/
test-results/
browser-profiles/

# ---- Terraform / infra state ----
.terraform/
*.tfstate
*.tfstate.*
cdk.out/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Next.js frontend ----
frontend/.next/
frontend/node_modules/
frontend/.env.local

# Editor and tooling directories at the repository root — never committed.
# Stated as a shape rather than a list of names: every tool that wants a
# home here puts it in a dot-directory, and an allowlist of the ones that
# exist today goes stale the first time a new one appears.
/.*/
!/.github/

# Everything under data/ is generated at runtime and nothing in it is source:
# the memory graph, per-run screenshots (deleted by `storage._purge_artifacts`
# when a trip completes) and Playwright's own output. 157 screenshots of real
# browsing sessions reached this repository before there was a rule, so the
# rule is now the whole directory rather than a list of what it holds today.
data/

# Generated instruction files at the root. Next writes one on every dev start
# unless `agentRules: false` is set in next.config.ts, which it is — this is
# the second line of defence. Same reasoning as above: the rule is "the only
# markdown that belongs at the root is the README", which stays true no
# matter what generates the next one. Documentation lives in docs/.
/*.md
!/README.md
