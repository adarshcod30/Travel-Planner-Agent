data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite3
logs/
*.log

# ---- Playwright / MCP runtime ----
.playwright-mcp/
playwright-report/
test-results/
browser-profiles/

# ---- Terraform / infra state ----
.terraform/
*.tfstate
*.tfstate.*
